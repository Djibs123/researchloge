# ============================================================
#  CONFIG CROUS WATCHER — copie ce fichier en ".env" et remplis-le
# ============================================================

# --- Recherche CROUS ---
# Une ou plusieurs URL (séparées par des virgules) copiées depuis la barre
# d'adresse de trouverunlogement.lescrous.fr après avoir filtré ville/prix.
CROUS_SEARCH_URL=https://trouverunlogement.lescrous.fr/tools/42/search?maxPrice=10000&bounds=6.134292_48.7092349_6.2126188_48.666906&locationName=Nancy+%2854000%29

# Fréquence de vérification, en secondes (60 = toutes les minutes)
CHECK_INTERVAL=60

# Filtre par nom de résidence (mots-clés séparés par des virgules).
# Ex : "monbois,libération" -> alerte SEULEMENT pour la résidence Monbois Libération.
# Laisse VIDE pour être alerté de TOUS les logements de la zone.
RESIDENCE_FILTER=

# --- Telegram (gratuit, sans limite) ---
# 1. Crée un bot via @BotFather sur Telegram (commande /newbot) -> il te donne un token.
# 2. Envoie n'importe quel message à ton bot pour qu'il connaisse ton chat_id.
# 3. Récupère ton chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
