# ============================================================
#  CONFIG CROUS WATCHER — copie ce fichier en ".env" et remplis-le
# ============================================================

# --- Recherche CROUS ---
# Colle l'URL EXACTE que tu vois dans la barre d'adresse du navigateur
# après avoir filtré (ville, prix, etc.) sur trouverunlogement.lescrous.fr
CROUS_SEARCH_URL=https://trouverunlogement.lescrous.fr/tools/42/search?maxPrice=10000&bounds=6.134292_48.7092349_6.2126188_48.666906&locationName=Nancy+%2854000%29

# Fréquence de vérification, en secondes (60 = toutes les minutes)
CHECK_INTERVAL=60

# Filtre par nom de résidence (mots-clés séparés par des virgules).
# Ex : "monbois,libération" -> alerte SEULEMENT pour la résidence Monbois Libération.
# Laisse VIDE pour être alerté de TOUS les logements de la zone.
RESIDENCE_FILTER=monbois,libération

# --- Twilio (WhatsApp + appel) ---
# Récupère ces 2 valeurs sur https://console.twilio.com (page d'accueil)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numéro WhatsApp d'envoi (celui du sandbox Twilio, à laisser tel quel au début)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Ton numéro Twilio pour PASSER les appels (Console > Phone Numbers).
# En compte d'essai gratuit, Twilio t'en donne un.
TWILIO_CALL_FROM=+1XXXXXXXXXX

# --- Tes numéros à toi (destinataires) ---
# Plusieurs numéros possibles, séparés par des virgules. Format international +33...
# WhatsApp : chaque numéro doit avoir rejoint le sandbox (voir README).
# (Tu peux en ajouter d'autres, séparés par une virgule.)
MY_WHATSAPP_NUMBERS=+33744242237

# Appels : en compte d'essai, chaque numéro doit être "vérifié" dans la console Twilio.
MY_PHONE_NUMBERS=+33744242237
