# Service systemd — fait tourner le watcher 24/7 et le redémarre tout seul
# (reboot du serveur ou plantage). Conçu pour un VPS Ubuntu (Oracle Cloud, user "ubuntu").
#
# Installation (voir HOSTING.md pour le détail) :
#   sudo cp crous-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crous-watcher
#   journalctl -u crous-watcher -f      # suivre les logs en direct

[Unit]
Description=CROUS Watcher - surveillance logement + alerte Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/researchloge
ExecStart=/usr/bin/python3 /home/ubuntu/researchloge/crous_watcher.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
