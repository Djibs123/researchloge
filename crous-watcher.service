# Service systemd — fait tourner le watcher 24/7 et le redémarre tout seul
# (reboot du serveur ou plantage). Conçu pour un VPS Ubuntu (Hetzner).
#
# Installation (voir HOSTING.md pour le détail) :
#   sudo cp crous-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crous-watcher
#   journalctl -u crous-watcher -f      # suivre les logs en direct

[Unit]
Description=CROUS Watcher - surveillance logement + alerte WhatsApp/appel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/researchloge
ExecStart=/usr/bin/python3 /root/researchloge/crous_watcher.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
