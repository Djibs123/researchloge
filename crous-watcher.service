# Fichier systemd pour faire tourner le watcher 24/7 sur un serveur Linux
# (Raspberry Pi, VPS, Oracle Cloud...).
#
# Installation :
#   1. Adapte les chemins /home/pi/... et l'utilisateur ci-dessous
#   2. sudo cp crous-watcher.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now crous-watcher
#   5. Suivre les logs : journalctl -u crous-watcher -f

[Unit]
Description=CROUS Watcher - surveillance logement + alerte WhatsApp/appel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/researchloge
ExecStart=/usr/bin/python3 /home/pi/researchloge/crous_watcher.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
