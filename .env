# ============================================================
#  TON .env — il ne reste QUE les 3 valeurs Twilio à remplir (marquées 👉 À REMPLIR)
# ============================================================

# --- Recherche CROUS (déjà configurée pour Nancy + Monbois Libération) ---
CROUS_SEARCH_URL=https://trouverunlogement.lescrous.fr/tools/42/search?maxPrice=10000&bounds=6.134292_48.7092349_6.2126188_48.666906&locationName=Nancy+%2854000%29
CHECK_INTERVAL=60
RESIDENCE_FILTER=monbois,libération

# --- Twilio ---
# 👉 À REMPLIR : copie depuis https://console.twilio.com (page d'accueil)
TWILIO_ACCOUNT_SID=
# 👉 À REMPLIR
TWILIO_AUTH_TOKEN=
# Numéro d'envoi WhatsApp du sandbox : laisse tel quel au début
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# 👉 À REMPLIR : ton numéro Twilio pour les appels (Console > Phone Numbers)
TWILIO_CALL_FROM=

# --- Destinataire (ton numéro, déjà rempli) ---
MY_WHATSAPP_NUMBERS=+33744242237
MY_PHONE_NUMBERS=+33744242237
